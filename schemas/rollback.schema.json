{
  "$defs": {
    "DriftEntry": {
      "description": "A filed unit that is not where the ledger says.",
      "properties": {
        "path": {
          "description": "Where the ledger has it, relative to the library.",
          "title": "Path",
          "type": "string"
        },
        "state": {
          "enum": [
            "moved",
            "missing",
            "modified"
          ],
          "title": "State",
          "type": "string"
        },
        "new_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where a moved unit is now.",
          "title": "New Path"
        }
      },
      "required": [
        "path",
        "state"
      ],
      "title": "DriftEntry",
      "type": "object"
    },
    "DriftSummary": {
      "description": "What the drift check found: units moved, edited or removed by hand since microfiche filed them.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/DriftEntry"
          },
          "title": "Items",
          "type": "array"
        },
        "recorded": {
          "description": "Whether the moved units were written to the ledger.",
          "title": "Recorded",
          "type": "boolean"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        }
      },
      "required": [
        "items",
        "recorded",
        "summary"
      ],
      "title": "DriftSummary",
      "type": "object"
    }
  },
  "description": "The result of ``rollback``.",
  "properties": {
    "version": {
      "default": 1,
      "description": "The shape's version. It changes only for a breaking change.",
      "title": "Version",
      "type": "integer"
    },
    "command": {
      "const": "rollback",
      "default": "rollback",
      "title": "Command",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "moves_reverted": {
      "title": "Moves Reverted",
      "type": "integer"
    },
    "folders_recreated": {
      "title": "Folders Recreated",
      "type": "integer"
    },
    "edited": {
      "description": "Units moved back whose content had changed since filing.",
      "items": {
        "type": "string"
      },
      "title": "Edited",
      "type": "array"
    },
    "drift": {
      "anyOf": [
        {
          "$ref": "#/$defs/DriftSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Filed units found out of place; null if none."
    }
  },
  "required": [
    "job_id",
    "moves_reverted",
    "folders_recreated"
  ],
  "title": "microfiche rollback --json",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
